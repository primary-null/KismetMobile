<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DASHBOARD"
                android:textColor="@color/accent_green"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_disconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISCONNECT"
                android:textSize="10sp"
                android:fontFamily="monospace"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/accent_red"
                android:textColor="@color/accent_red" />
        </LinearLayout>

        <!-- Two-column body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- LEFT COLUMN: server + PHY + sources -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <!-- Server card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/bg_surface"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="@color/accent_green"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SERVER"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.2" />
                            <TextView
                                android:id="@+id/tv_server_address"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="@color/accent_green"
                                android:textSize="16sp"
                                android:fontFamily="monospace" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tv_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ONLINE"
                            android:textColor="@color/accent_green"
                            android:textSize="11sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- PHY cards row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_wifi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/bg_surface"
                        app:cardCornerRadius="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tv_wifi_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/phy_wifi"
                                android:textSize="20sp"
                                android:fontFamily="monospace" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="WiFi"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp"
                                android:fontFamily="monospace" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_bt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/bg_surface"
                        app:cardCornerRadius="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tv_bt_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/phy_bt"
                                android:textSize="20sp"
                                android:fontFamily="monospace" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BT"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp"
                                android:fontFamily="monospace" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_sdr"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/bg_surface"
                        app:cardCornerRadius="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tv_sdr_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/phy_sdr"
                                android:textSize="20sp"
                                android:fontFamily="monospace" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SDR"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp"
                                android:fontFamily="monospace" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_other"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/bg_surface"
                        app:cardCornerRadius="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tv_other_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/phy_other"
                                android:textSize="20sp"
                                android:fontFamily="monospace" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Other"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp"
                                android:fontFamily="monospace" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Capture sources -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/bg_surface"
                    app:cardCornerRadius="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="CAPTURE SOURCES"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.2"
                            android:layout_marginBottom="8dp" />
                        <LinearLayout
                            android:id="@+id/ll_sources"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- RIGHT COLUMN: stats grid -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_gravity="top"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="8dp">
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:padding="12dp">

                    <LinearLayout
                        android:id="@+id/cell_total_devices"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <TextView
                            android:text="TOTAL DEVICES"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:id="@+id/tv_device_count"
                            android:text="—"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:fontFamily="monospace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <TextView
                            android:text="SOURCES"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:id="@+id/tv_source_count"
                            android:text="—"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:fontFamily="monospace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <TextView
                            android:text="TOTAL PACKETS"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:id="@+id/tv_packet_total"
                            android:text="—"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:fontFamily="monospace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <TextView
                            android:text="SERVER MEMORY"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:id="@+id/tv_memory"
                            android:text="—"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:fontFamily="monospace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="2"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <TextView
                            android:text="SERVER TIME"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:id="@+id/tv_uptime"
                            android:text="—"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:fontFamily="monospace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                </GridLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
