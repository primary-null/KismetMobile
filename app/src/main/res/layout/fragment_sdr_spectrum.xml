<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RF SPECTRUM"
            android:textColor="@color/phy_sdr"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/tv_last_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Band filter chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="12dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/chip_all_bands"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ALL" android:textSize="11sp" android:fontFamily="monospace"
                android:paddingHorizontal="14dp" android:paddingVertical="6dp"
                android:layout_marginEnd="6dp" android:background="@drawable/chip_filter_bg"
                android:textColor="@color/chip_text_selector"
                android:clickable="true" android:focusable="true" />

            <TextView android:id="@+id/chip_2g"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="2.4G" android:textSize="11sp" android:fontFamily="monospace"
                android:paddingHorizontal="14dp" android:paddingVertical="6dp"
                android:layout_marginEnd="6dp" android:background="@drawable/chip_filter_bg"
                android:textColor="@color/chip_text_selector"
                android:clickable="true" android:focusable="true" />

            <TextView android:id="@+id/chip_5g"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="5G" android:textSize="11sp" android:fontFamily="monospace"
                android:paddingHorizontal="14dp" android:paddingVertical="6dp"
                android:layout_marginEnd="6dp" android:background="@drawable/chip_filter_bg"
                android:textColor="@color/chip_text_selector"
                android:clickable="true" android:focusable="true" />

            <TextView android:id="@+id/chip_6g"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="6G" android:textSize="11sp" android:fontFamily="monospace"
                android:paddingHorizontal="14dp" android:paddingVertical="6dp"
                android:background="@drawable/chip_filter_bg"
                android:textColor="@color/chip_text_selector"
                android:clickable="true" android:focusable="true" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Spectrum + waterfall (horizontally scrollable) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="false">

        <com.kismet.mobile.sdr.SpectrumView
            android:id="@+id/spectrum_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />

    </HorizontalScrollView>

    <!-- Bottom stats bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bg_surface"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_label_stat1"
                android:text="PEAK CHANNEL"
                android:textColor="@color/text_secondary" android:textSize="8sp"
                android:fontFamily="monospace" android:letterSpacing="0.2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tv_peak_channel"
                android:text="—" android:textColor="@color/phy_sdr" android:textSize="16sp"
                android:fontFamily="monospace"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_label_stat2"
                android:text="PEAK SIGNAL"
                android:textColor="@color/text_secondary" android:textSize="8sp"
                android:fontFamily="monospace" android:letterSpacing="0.2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tv_peak_signal"
                android:text="—" android:textColor="@color/text_primary" android:textSize="16sp"
                android:fontFamily="monospace"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_label_stat3"
                android:text="CHANNELS"
                android:textColor="@color/text_secondary" android:textSize="8sp"
                android:fontFamily="monospace" android:letterSpacing="0.2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tv_channel_count"
                android:text="—" android:textColor="@color/text_primary" android:textSize="16sp"
                android:fontFamily="monospace"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
