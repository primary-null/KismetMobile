<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DEVICES"
            android:textColor="@color/accent_green"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/tv_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 devices"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_campaign"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show only devices in Active Campaigns"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="@color/text_secondary"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp" />

    <!-- Filter chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALL"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/chip_filter_bg"
                android:textColor="@color/chip_text_selector"
                android:clickable="true"
                android:focusable="true"
                 />

            <TextView
                android:id="@+id/chip_wifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WiFi"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/chip_filter_bg"
                android:textColor="@color/chip_text_selector"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_bt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BT"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/chip_filter_bg"
                android:textColor="@color/chip_text_selector"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_sdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SDR"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/chip_filter_bg"
                android:textColor="@color/chip_text_selector"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_other"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OTHER"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:background="@drawable/chip_filter_bg"
                android:textColor="@color/chip_text_selector"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.appcompat.widget.SearchView
        android:id="@+id/search_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:background="@color/bg_surface"
        android:queryHint="search mac, name, phy..."
        android:iconifiedByDefault="false" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_verify_proximity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:text="VERIFY PROXIMITY (2ND LATCH)"
        android:fontFamily="monospace"
        android:backgroundTint="@color/bg_surface"
        android:textColor="@color/accent_cyan"
        android:visibility="gone"
        app:strokeColor="@color/accent_cyan"
        app:strokeWidth="1dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

</LinearLayout>
